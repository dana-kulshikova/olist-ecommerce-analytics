table 'public bi_orders'
	lineageTag: 1f6f9a30-f325-4834-acc4-1932e486567e

	measure 'Total Product Sales' =
			
			CALCULATE(
			    SUM('public bi_orders'[product_sales]),
			    'public bi_orders'[order_status] = "delivered")
		formatString: "R$ "#,##0.00
		lineageTag: 73da7905-946a-45be-a495-66ce2b782599

	measure 'Total Orders' =
			
			CALCULATE(
			    DISTINCTCOUNT('public bi_orders'[order_id]),
			    'public bi_orders'[order_status] = "delivered"
			)
		formatString: #,##0
		lineageTag: 1e1cd6bf-0343-48ec-bbdd-fbf27b29d71b

	measure 'Average Order Value' =
			
			DIVIDE(
			    [Total Product Sales],
			    [Total Orders]
			)
		formatString: "R$ "#,##0.00
		lineageTag: d88d209a-7d65-493b-b102-77483935ca22

	measure 'Average Delivery Time' =
			
			CALCULATE(
			    AVERAGEX(
			        'public bi_orders',
			        DATEDIFF(
			            'public bi_orders'[order_purchase_timestamp],
			            'public bi_orders'[order_delivered_customer_date],
			            DAY
			        )
			    ),
			    'public bi_orders'[order_status] = "delivered",
			    'public bi_orders'[valid_delivery_dates] = TRUE()
			)
		formatString: 0.0 "days"
		lineageTag: 3167f9d1-7f5a-4ea1-bc56-cffbc5de8ed3

	measure 'On-Time Delivery Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('public bi_orders'),
			        'public bi_orders'[order_status] = "delivered",
			        NOT(ISBLANK('public bi_orders'[order_delivered_customer_date])),
			        INT('public bi_orders'[order_delivered_customer_date]) <= INT('public bi_orders'[order_estimated_delivery_date])
			    ),
			    CALCULATE(
			        COUNTROWS('public bi_orders'),
			        'public bi_orders'[order_status] = "delivered",
			        NOT(ISBLANK('public bi_orders'[order_delivered_customer_date]))
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 06cb11be-bb90-4042-9941-4a66efc9fdf0

	measure 'Key Takeaways' = ```
			
			"• R$ " & FORMAT([Total Product Sales] / 1000000, "#,##0.00") & "M in total product sales across "
			& FORMAT([Total Orders], "#,##0") & " orders."
			& UNICHAR(10) & UNICHAR(10)
			& "• Average order value: R$ "
			& FORMAT([Average Order Value], "#,##0.00") & "."
			& UNICHAR(10) & UNICHAR(10)
			& "• Average delivery time: "
			& FORMAT([Average Delivery Time], "0.00") & " days."
			& UNICHAR(10) & UNICHAR(10)
			& "• On-time delivery rate: "
			& FORMAT([On-Time Delivery Rate], "0.00%") & "."
			
			```
		lineageTag: 98d3778a-9186-4dcb-a087-9346a6b95f04

	measure 'Top State by Sales' =
			
			VAR TopStateRow =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES('public bi_orders'[customer_state]),
			            "@Sales", [Total Product Sales]
			        ),
			        [@Sales], DESC
			    )
			RETURN
			    IF(
			        NOT(ISBLANK([Total Product Sales])),
			        MAXX(TopStateRow, 'public bi_orders'[customer_state])
			    )
		lineageTag: 5f0d7a3e-2c41-4b8e-9a56-3e1c7d90b2a4

	measure 'Top State Sales Share' =
			
			VAR TopStateSales =
			    MAXX(
			        VALUES('public bi_orders'[customer_state]),
			        [Total Product Sales]
			    )
			RETURN
			    DIVIDE(TopStateSales, [Total Product Sales])
		formatString: 0.0%
		lineageTag: a2c86e14-7b3f-4d09-8e52-6f4b1d3ac975

	measure 'Delivered Orders With Date' = ```
			
			CALCULATE (
			    COUNTROWS ( 'public bi_orders' ),
			    KEEPFILTERS ( 'public bi_orders'[order_status] = "delivered" ),
			    KEEPFILTERS (
			        NOT ISBLANK ( 'public bi_orders'[order_delivered_customer_date] )
			    )
			)
			
			```
		formatString: 0
		lineageTag: fd2381d9-e563-4e38-bfbc-99958cfc93e8

	measure 'Late Orders' = ```
			
			CALCULATE (
			    [Delivered Orders With Date],
			    KEEPFILTERS (
			        INT ( 'public bi_orders'[order_delivered_customer_date] )
			        > INT ( 'public bi_orders'[order_estimated_delivery_date] )
			    )
			)
			
			```
		formatString: #,0
		lineageTag: 6ea6bc25-710d-48fa-bf4b-3ee98194c94b

	measure 'Late Delivery Rate' = ```
			
			DIVIDE (
			    [Late Orders],
			    [Delivered Orders With Date]
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e1cb816c-cb48-4c99-8143-7b469becfb77

	measure 'Median Promised Days' = ```
			
			MEDIANX (
			    FILTER (
			        'public bi_orders',
			        'public bi_orders'[order_status] = "delivered"
			            && NOT ISBLANK (
			                'public bi_orders'[order_delivered_customer_date]
			            )
			    ),
			    DATEDIFF (
			        'public bi_orders'[order_purchase_timestamp],
			        'public bi_orders'[order_estimated_delivery_date],
			        DAY
			    )
			)
			
			```
		formatString: 0.0
		lineageTag: 388debf9-31cf-4daa-bbd5-8f5c47a10ac9

	measure 'Median Actual Days' = ```
			
			MEDIANX (
			    FILTER (
			        'public bi_orders',
			        'public bi_orders'[order_status] = "delivered"
			            && NOT ISBLANK (
			                'public bi_orders'[order_delivered_customer_date]
			            )
			    ),
			    DATEDIFF (
			        'public bi_orders'[order_purchase_timestamp],
			        'public bi_orders'[order_delivered_customer_date],
			        DAY
			    )
			)
			
			```
		formatString: 0.0
		lineageTag: ab122a93-c218-4992-b733-ad494390f9c4

	measure 'Not Delivered Share' = ```
			
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( 'public bi_orders' ),
			        KEEPFILTERS (
			            'public bi_orders'[order_status] <> "delivered"
			        )
			    ),
			    COUNTROWS ( 'public bi_orders' )
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fc0b5f9e-b490-46b8-b248-96cb575a3064

