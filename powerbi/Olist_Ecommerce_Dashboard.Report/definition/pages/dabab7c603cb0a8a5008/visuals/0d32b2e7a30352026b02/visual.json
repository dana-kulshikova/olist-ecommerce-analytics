              {
                "textRuns": [
                  {
                    "value": "Research Findings",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#142C4E",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Fixed results from the full 2016–2018 analysis | Observational | Not affected by filters",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#5B6B82",
                      "fontStyle": "italic"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. RJ vs SP customers",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#142C4E",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "+7.46 percentage points adjusted late-delivery difference (95% CI 5.88 to 9.13). Supported (provisional). Compares customer states, not a shipping route.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#3D4F6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Late delivery and low ratings",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#142C4E",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "+51.04 points adjusted low-rating difference (95% CI 49.58 to 52.28). Supported (provisional). An association, not a cause.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#3D4F6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Multi-item orders",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#142C4E",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "+12.67 points adjusted low-rating difference (95% CI 11.26 to 13.76). Exploratory.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#3D4F6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Low ratings on on-time orders",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#142C4E",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "67.54% of low ratings among reviewed delivered orders were on on-time orders. Exploratory.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#3D4F6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Recommended investigations",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#142C4E",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Why RJ customers' orders were late more often than SP customers'.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#3D4F6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Why customers rated on-time orders low.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#3D4F6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• What goes wrong on multi-item orders.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#3D4F6B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Investigations, not proven interventions. Charts are unadjusted and respond to filters; these findings are fixed. Source: docs/business_recommendations.md",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#5B6B82",
                      "fontStyle": "italic"
                    }
                  }
                ]
              }
            ]
